generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InternshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  internships Internship[]
}

model Internship {
  id            String          @id @default(cuid())
  userId        String
  company       String
  supervisor    String
  requiredHours Int
  startDate     DateTime
  endDate       DateTime?
  status        InternshipStatus  @default(PENDING)
  checklist     ChecklistItem[]
  user          User            @relation(fields: [userId], references: [id])
  logEntries    LogEntry[]

  @@index([userId])
}

model LogEntry {
  id           String     @id @default(cuid())
  date         DateTime
  description  String
  hours        Float
  createdAt    DateTime   @default(now())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id])

  @@index([internshipId])
}

model ChecklistItem {
  id           String     @id @default(cuid())
  title        String
  completed    Boolean    @default(false)
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id])

  @@index([internshipId])
}
