# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already covered by .gitignore.

# PostgreSQL connection string.
# Local example: postgresql://postgres:password@localhost:5432/ojt_tracker
# Hosted example (Neon/Supabase): copy the connection string from their dashboard.
DATABASE_URL=""

# Better Auth signing secret. Any long random string works — generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The base URL of this app. Local dev should always be:
BETTER_AUTH_URL="http://localhost:3000"

# --- Not yet used locally ---
# DIRECT_URL is only needed once the project moves to a pooled Postgres
# provider (Neon/Supabase/Vercel Postgres) for production — see Section 4B
# of ARCHITECTURE.md. Local development uses a single direct connection
# via DATABASE_URL above, so this can stay unset until deployment.
# DIRECT_URL=""
