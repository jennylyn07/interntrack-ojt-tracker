# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already covered by .gitignore.

# -------------------------------------------------------
# DATABASE_URL — Pooled connection string (used by the app at runtime).
# In Neon: the hostname contains "-pooler". Example:
#   postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local (no pooler): postgresql://postgres:password@localhost:5432/ojt_tracker
# -------------------------------------------------------
DATABASE_URL=""

# -------------------------------------------------------
# DIRECT_URL — Direct (non-pooled) connection string (used by prisma migrate).
# In Neon: same as DATABASE_URL but WITHOUT "-pooler" in the hostname. Example:
#   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local: same as DATABASE_URL (local Postgres is always a direct connection).
# -------------------------------------------------------
DIRECT_URL=""

# Better Auth signing secret. Any long random string works — generate one with:
#   node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# The base URL of this app.
# Local dev: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
